# Python
__pycache__/
*.py[cod]
*.egg-info/

# Virtual environment
.venv/

# Environment variables / secrets
.env
.env.*

# Jupyter
.ipynb_checkpoints/

# ML models & checkpoints
models/
checkpoints/
*.safetensors
*.bin
*.pt
*.pth

# Large datasets
data/raw/*
data/processed/*
data/rejected/*
data/splits/*

# Logs / experiment outputs
logs/
wandb/
mlruns/

# OS files
.DS_Store

# External datasets: sources are cloned, converted files are rebuilt by
# scripts/build_external_dataset.py (audit.json and SAMPLES.md are committed)
data/external/raw/
data/external/**/*.jsonl
# ...except distilled targets: produced by an expensive GPU run, so they are committed
!data/external/distilled/*.jsonl
